# ===== 動作モード =====
# paper  : 仮想口座でシミュレーション（デフォルト・API キー不要）
# notify : 売買シグナルを Discord に通知するだけ（発注はしない）
# live   : bitFlyer に実際に成行注文を出す
TRADE_MODE=paper
# live モードで実発注するには次の値を正確に設定する必要があります
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# ===== bitFlyer API（notify/live で使用）=====
# bitFlyer Lightning → API から発行。権限は「資産」「トレード」のみ付与し、
# 「入出金」「出金」は絶対に付与しないでください。IP 制限も推奨。
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# ===== Claude によるニュース分析（未設定ならテクニカル指標のみで判断）=====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
# ニュース分析の間隔（分）。短くするほど API 料金がかかります
NEWS_INTERVAL_MINUTES=240
# カンマ区切りの RSS フィード（省略時は CoinDesk / Cointelegraph / CoinPost）
# NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://coinpost.jp/?feed=rss2

# ===== Discord 通知（任意）=====
# チャンネル設定 → 連携サービス → ウェブフック で作成した URL
DISCORD_WEBHOOK_URL=
# true にすると様子見（HOLD）も毎回通知
NOTIFY_HOLD=false

# ===== 売買ルール =====
LOOP_INTERVAL_MINUTES=60
# 1回の注文数量（bitFlyer の最小は 0.001 BTC）
TRADE_SIZE_BTC=0.001
# これ以上は絶対に売らないコア保有量
CORE_BTC=0.001
# 合成スコア(-1〜+1)がこの値を超えたら買い / 下回ったら売り
BUY_THRESHOLD=0.4
SELL_THRESHOLD=-0.4
# 取引後に次の取引を禁止する時間
COOLDOWN_HOURS=12
MAX_TRADES_PER_DAY=2
# 1回の買いに使う日本円の上限
MAX_JPY_PER_TRADE=30000
# スコアの重み
WEIGHT_TREND=0.4
WEIGHT_MOMENTUM=0.3
WEIGHT_NEWS=0.3

# ===== ペーパートレード / バックテスト =====
PAPER_START_BTC=0.003
PAPER_START_JPY=0
# bitFlyer 現物の取引手数料（直近30日の取引量で 0.01〜0.15%）
FEE_RATE=0.0015

DATA_DIR=data
# CoinGecko の Demo API キー（任意。レート制限緩和用）
# COINGECKO_API_KEY=

{
  "name": "btc-trader",
  "version": "1.0.0",
  "description": "bitFlyer BTC/JPY の半自動売買ツール（ニュース分析 + テクニカル指標）",
  "main": "dist/index.js",
  "scripts": {
    "once": "tsx src/index.ts once",
    "start": "tsx src/index.ts loop",
    "status": "tsx src/index.ts status",
    "backtest": "tsx src/backtest.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js loop",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}

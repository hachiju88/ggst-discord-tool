---
/**
 * 記事一覧＋絞り込み。category を省略すると全記事。
 * 絞り込み: バージョン / カテゴリ / 立ち位置 / 始動技 / カウンターヒット / タグ / お気に入り
 * 並び替え: 標準 / いいねが多い順
 */
import { getCollection } from 'astro:content';
import Meta from './Meta.astro';
import VideoPlayer from './VideoPlayer.astro';
import Combo from './Combo.astro';
import Reactions from './Reactions.astro';
import { CATEGORIES, POSITIONED, VERSIONS, CURRENT_VERSION, isOld, validVersions, type CategoryId } from '../site.config';

interface Props {
  category?: CategoryId;
}
const { category } = Astro.props;
const catIds = CATEGORIES.map((c) => c.id) as string[];

const docs = (await getCollection('docs'))
  .filter((d) => {
    const top = d.id.split('/')[0];
    if (!catIds.includes(top) || d.id === top) return false; // 一覧ページ自身は除外
    return category ? top === category : true;
  })
  .sort((a, b) => a.id.localeCompare(b.id, 'ja'));

const showPosition = !category || POSITIONED.includes(category);
const starters = [...new Set(docs.map((d) => d.data.starter).filter(Boolean))] as string[];
const tags = [...new Set(docs.flatMap((d) => d.data.tags))];
const hasCH = docs.some((d) => d.data.counterHit !== undefined);
const catLabel = (id: string) => CATEGORIES.find((c) => c.id === id.split('/')[0])!;
const firstCombo = (d: (typeof docs)[number]) => {
  const c = d.data.combos[0];
  return c ? (typeof c === 'string' ? c : c.route) : undefined;
};
---

<div class="article-list not-content" data-article-list>
  <form class="filters" onsubmit="return false">
    <label>
      <span>バージョン</span>
      <select name="version">
        {[...VERSIONS].reverse().map((v) => (
          <option value={`v:${v}`}>Ver.{v}{v === CURRENT_VERSION ? '（現行）' : ''} で使える</option>
        ))}
        <option value="old">oldのみ（現行で使えない）</option>
        <option value="all">すべて</option>
      </select>
    </label>
    {
      !category && (
        <label>
          <span>カテゴリ</span>
          <select name="category">
            <option value="">すべて</option>
            {CATEGORIES.map((c) => (
              <option value={c.id}>{c.label}</option>
            ))}
          </select>
        </label>
      )
    }
    {
      showPosition && (
        <label>
          <span>立ち位置</span>
          <select name="position">
            <option value="">すべて</option>
            <option value="center">画面中央</option>
            <option value="corner">画面端</option>
          </select>
        </label>
      )
    }
    {
      starters.length > 0 && (
        <label>
          <span>始動技</span>
          <select name="starter">
            <option value="">すべて</option>
            {starters.map((s) => (
              <option value={s}>{s}</option>
            ))}
          </select>
        </label>
      )
    }
    {
      hasCH && (
        <label>
          <span>カウンター</span>
          <select name="ch">
            <option value="">すべて</option>
            <option value="yes">CHあり</option>
            <option value="no">CHなし</option>
          </select>
        </label>
      )
    }
    <label>
      <span>並び順</span>
      <select name="sort">
        <option value="">標準</option>
        <option value="likes">いいねが多い順</option>
      </select>
    </label>
    {
      tags.length > 0 && (
        <fieldset class="tag-filter">
          <legend>タグ</legend>
          {tags.map((t) => (
            <label class="tag-toggle">
              <input type="checkbox" name="tag" value={t} />
              <span>#{t}</span>
            </label>
          ))}
        </fieldset>
      )
    }
    <div class="filter-switches">
      <label class="switch fav-switch">
        <input type="checkbox" name="fav" />
        <span>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"></path></svg
          >
          お気に入りのみ
        </span>
      </label>
      <label class="switch">
        <input type="checkbox" name="video" />
        <span>動画ありのみ</span>
      </label>
    </div>
  </form>

  <div class="list-head">
    <p class="count" aria-live="polite"><span data-count>{docs.length}</span> 件</p>
    <a class="write-link" href={category ? `/edit/?category=${category}` : '/edit/'}>＋ 記事を書く</a>
  </div>

  <ul class="cards">
    {
      docs.map((d, i) => (
        <li
          class:list={['card', { 'is-old': isOld(d.data), 'has-media': d.data.videos.length > 0 }]}
          data-id={d.id}
          data-index={i}
          data-old={isOld(d.data) ? '1' : '0'}
          data-valid={validVersions(d.data)?.join(' ') ?? '*'}
          data-category={d.id.split('/')[0]}
          data-position={d.data.position ?? ''}
          data-starter={d.data.starter ?? ''}
          data-ch={d.data.counterHit === undefined ? '' : d.data.counterHit ? 'yes' : 'no'}
          data-video={d.data.videos.length > 0 ? '1' : '0'}
          data-tags={d.data.tags.join('|')}
        >
          {d.data.videos.length > 0 && (
            <div class="card-media">
              <VideoPlayer video={d.data.videos[0]} mode="card" more={d.data.videos.length - 1} />
            </div>
          )}
          <div class="card-body">
            <a class="card-link" href={`/${d.id}/`}>
              {!category && <span class="card-cat">{catLabel(d.id).en}</span>}
              <span class="card-title">{d.data.title}</span>
              {d.data.description && <span class="card-desc">{d.data.description}</span>}
            </a>
            {firstCombo(d) && <Combo route={firstCombo(d)!} compact />}
            <Meta data={d.data} compact />
            <div class="card-foot">
              <Reactions page={d.id} size="sm" />
              {d.data.training.length > 0 && <span class="card-training">練習あり</span>}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
  <p class="empty" hidden>条件に合う記事がありません。</p>
</div>

<script>
  import { state } from '../scripts/reactions';
  import { loginUrl } from '../scripts/login';

  for (const root of document.querySelectorAll<HTMLElement>('[data-article-list]')) {
    const form = root.querySelector('form')!;
    const list = root.querySelector<HTMLElement>('.cards')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const count = root.querySelector('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('.empty')!;

    // ?fav=1 でお気に入りのみを最初から有効に
    const params = new URLSearchParams(location.search);
    if (params.get('fav') === '1') (form.elements.namedItem('fav') as HTMLInputElement).checked = true;

    const apply = () => {
      const fd = new FormData(form);
      const ver = String(fd.get('version') ?? '');
      const cat = String(fd.get('category') ?? '');
      const pos = String(fd.get('position') ?? '');
      const starter = String(fd.get('starter') ?? '');
      const ch = String(fd.get('ch') ?? '');
      const tags = fd.getAll('tag').map(String);
      const favOnly = fd.has('fav');
      const videoOnly = fd.has('video');
      const sort = String(fd.get('sort') ?? '');

      let n = 0;
      for (const c of cards) {
        const d = c.dataset;
        const old = d.old === '1';
        const ok =
          (ver === 'all' ||
            (ver === 'old' && old) ||
            (ver.startsWith('v:') && (d.valid === '*' || d.valid!.split(' ').includes(ver.slice(2))))) &&
          (!cat || d.category === cat) &&
          (!pos || d.position === pos) &&
          (!starter || d.starter === starter) &&
          (!ch || d.ch === ch) &&
          (!favOnly || state.mine.fav.has(d.id!)) &&
          (!videoOnly || d.video === '1') &&
          tags.every((t) => d.tags!.split('|').includes(t));
        c.hidden = !ok;
        if (ok) n++;
      }

      const sorted = [...cards].sort((a, b) =>
        sort === 'likes'
          ? (state.likes[b.dataset.id!] ?? 0) - (state.likes[a.dataset.id!] ?? 0) ||
            Number(a.dataset.index) - Number(b.dataset.index)
          : Number(a.dataset.index) - Number(b.dataset.index),
      );
      if (sorted.some((c, i) => list.children[i] !== c)) list.append(...sorted);

      const loading = favOnly && !state.ready;
      count.textContent = loading ? '-' : String(n);
      empty.hidden = n > 0;
      if (favOnly && !loading && !state.preview && !state.loggedIn) {
        // お気に入りはログインした人だけのもの
        const a = document.createElement('a');
        a.href = loginUrl();
        a.textContent = 'ログイン';
        empty.replaceChildren('お気に入りを使うには', a, 'してください。');
        return;
      }
      empty.textContent = loading
        ? 'お気に入りを読み込み中…'
        : favOnly && n === 0 && !state.mine.fav.size
          ? 'まだお気に入りがありません。記事の ★ を押すと追加できます。'
          : '条件に合う記事がありません。';
    };
    // カードの登場アニメーションは最初の表示だけ（絞り込み・並び替えのたびに再生しない）
    const settle = () => list.classList.add('is-settled');
    setTimeout(settle, 1000);
    form.addEventListener('change', () => {
      settle();
      apply();
    });
    // お気に入りを外したときは一覧から消さず、次に条件を変えたときに反映する
    let first = true;
    document.addEventListener('reactions:change', () => {
      if (first || (form.elements.namedItem('sort') as HTMLSelectElement).value === 'likes') apply();
      first = false;
    });
    apply();
  }
</script>

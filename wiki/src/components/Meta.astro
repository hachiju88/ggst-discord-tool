---
/** 記事のメタ情報（バージョン・立ち位置・始動技・CH・タグ）をチップで表示 */
import { CURRENT_VERSION, POSITION_LABEL, isOld } from '../site.config';

interface Props {
  data: Record<string, any>;
  compact?: boolean;
}
const { data, compact = false } = Astro.props;
const old = isOld(data);
---

<ul class:list={['meta', { compact }]}>
  {
    data.version &&
      (old ? (
        <li class="chip old">OLD{data.brokenIn ? ` · Ver.${data.brokenIn}で不可` : ''}</li>
      ) : (
        <li class="chip ver">Ver.{data.version}{data.version === CURRENT_VERSION ? ' 現行' : ''}</li>
      ))
  }
  {data.position && <li class="chip pos">{POSITION_LABEL[data.position as 'center' | 'corner']}</li>}
  {data.starter && <li class="chip starter">始動 {data.starter}</li>}
  {data.counterHit !== undefined && (
    <li class:list={['chip', data.counterHit ? 'ch' : 'noch']}>{data.counterHit ? 'COUNTER' : 'ノーマルヒット'}</li>
  )}
  {data.opponent && <li class="chip opp">vs {data.opponent}</li>}
  {data.damage && <li class="chip stat">{data.damage} dmg</li>}
  {
    data.difficulty && (
      <li class="chip stat" title={`難易度 ${data.difficulty}/5`}>
        {'◆'.repeat(data.difficulty)}
        <span class="dim">{'◆'.repeat(5 - data.difficulty)}</span>
      </li>
    )
  }
  {!compact && data.tags?.map((t: string) => <li class="chip tag">#{t}</li>)}
</ul>

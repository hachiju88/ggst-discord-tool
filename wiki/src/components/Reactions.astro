---
/** いいね（サムズアップ）・お気に入り（星）ボタン */
interface Props {
  page: string;
  size?: 'sm' | 'md';
}
const { page, size = 'md' } = Astro.props;
---

<div class:list={['reactions', size]}>
  <button type="button" class="react like" data-react data-kind="like" data-page={page} aria-pressed="false" title="いいね">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3m0 11V11m0 11h10.3a2 2 0 0 0 2-1.7l1.4-9A2 2 0 0 0 18.7 9H14V5a3 3 0 0 0-3-3L7 11"
      ></path></svg
    >
    <span data-like-count data-page={page}>0</span>
    <span class="sr-only">いいね</span>
  </button>
  <button type="button" class="react fav" data-react data-kind="fav" data-page={page} aria-pressed="false" title="お気に入り">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"></path></svg
    >
    <span class="sr-only">お気に入り</span>
  </button>
</div>

<script>
  import '../scripts/reactions';
</script>

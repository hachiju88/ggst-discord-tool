---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import Comments from '../Comments.astro';
import VideoPlayer from '../VideoPlayer.astro';
import Combo from '../Combo.astro';
import RelatedTraining from '../RelatedTraining.astro';
import { bodyVideos } from '../../lib/video';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as Record<string, any>;
const showComments = data.comments !== false && data.template !== 'splash';
// 本文に置いた動画（![タイトル](URL)）は上にまとめて出さない。1本目は一覧カードのサムネとして使われる
const inBody = new Set(bodyVideos(route.entry.body).map((v) => v.url));
const videos = (data.videos ?? []).filter((v: any) => !inBody.has(typeof v === 'string' ? v : v.url));
const combos = (data.combos ?? []).map((c: any) => (typeof c === 'string' ? { route: c } : c));
---

{
  videos.length > 0 && (
    <div class:list={['videos not-content', { multi: videos.length > 1 }]}>
      {videos.map((v: any) => (
        <VideoPlayer video={v} />
      ))}
    </div>
  )
}
{combos.map((c: any) => <Combo {...c} />)}
<Default><slot /></Default>
<RelatedTraining />
{showComments && <Comments pageId={route.id} />}

<script>
  import '../../scripts/player';
</script>
